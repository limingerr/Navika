# ============================================================
# NAVIKA - Konfigurasi Lingkungan Supabase (Backend)
# ============================================================
# Dapatkan nilai ini dari Dashboard Supabase -> Project Settings -> API

# URL Proyek Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Kunci publishable Supabase (aman di browser jika RLS aktif)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# Kunci Service Role Supabase (HANYA UNTUK SERVER - JANGAN ekspos ke client-side)
# Diperlukan agar server dapat membaca seluruh email pengguna dari Supabase Auth
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Kredensial Admin Demo (Hanya untuk mode development/demo tanpa Supabase)
# Ganti dengan nilai acak yang kuat — JANGAN gunakan nilai ini di production
NEXT_PUBLIC_ADMIN_TOKEN=your-admin-token-here
NEXT_PUBLIC_ADMIN_PASSWORD=your-admin-password-here

# ============================================================
# OneSignal Web Push SDK & Server REST API
# ============================================================
NEXT_PUBLIC_ONESIGNAL_APP_ID=your-onesignal-app-id-here
ONESIGNAL_REST_API_KEY=your-onesignal-rest-api-key-here

# ============================================================
# Nodemailer (Gmail SMTP) Notification Service
# ============================================================
# Gunakan alamat Gmail dan 16 karakter Sandi Aplikasi Google (App Password)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-google-app-password-16-chars
NOTIFICATION_EMAIL_TO=mahasiswa@example.com

# Opsional: Resend API Key jika ingin fallback
RESEND_API_KEY=your-resend-api-key-here
RESEND_FROM_EMAIL=NAVIKA <onboarding@resend.dev>

# URL Situs (untuk tautan notifikasi)
NEXT_PUBLIC_SITE_URL=https://navika-pi.vercel.app

# ============================================================
# Microsoft Clarity Analytics & Heatmap
# ============================================================
NEXT_PUBLIC_CLARITY_PROJECT_ID=your-clarity-project-id-here

# ============================================================
# Google Analytics 4 (GA4)
# ============================================================
NEXT_PUBLIC_GA_MEASUREMENT_ID=your-ga-measurement-id-here
